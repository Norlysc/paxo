# ==========================================================================
# PAXO PLATFORM — Variables de entorno
# ==========================================================================
# Copia este archivo como .env.local en la raíz del monorepo y completa los
# valores. Un solo .env.local sirve para apps/web y apps/admin: cada app lo
# carga automáticamente desde su next.config.mjs (process.loadEnvFile).
#
# IMPORTANTE:
#   - Las variables con prefijo NEXT_PUBLIC_ se incluyen en el bundle del
#     navegador. NUNCA coloques secretos (API keys privadas, service role)
#     bajo ese prefijo.
#   - Las variables SIN ese prefijo solo son accesibles desde el servidor
#     (Route Handlers / Server Components) — las usa apps/admin.
#   - .env.local nunca se sube a git (ver .gitignore). Este archivo sí.
# ==========================================================================

# --------------------------------------------------------------------------
# CONFIGURACIÓN GENERAL DE LA APLICACIÓN
# --------------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=PAXO Platform
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --------------------------------------------------------------------------
# SUPABASE — base de datos, autenticación y storage
# --------------------------------------------------------------------------
# URL del proyecto y clave pública (anon). Se exponen al navegador; la
# seguridad la garantizan las políticas de RLS, no el secreto de esta clave.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave de servicio: acceso total, sin restricciones de RLS.
# SOLO servidor (apps/admin). Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --------------------------------------------------------------------------
# IA EMPRESARIAL — Anthropic (asistente del panel admin)
# --------------------------------------------------------------------------
# SOLO servidor. Usada por apps/admin/app/api/ai-insights/route.ts.
ANTHROPIC_API_KEY=

# --------------------------------------------------------------------------
# GOOGLE ANALYTICS
# --------------------------------------------------------------------------
# ID de medición GA4, formato G-XXXXXXXXXX. Landing pública.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# --------------------------------------------------------------------------
# META PIXEL — Facebook / Instagram Ads
# --------------------------------------------------------------------------
NEXT_PUBLIC_META_PIXEL_ID=

# --------------------------------------------------------------------------
# GOOGLE MAPS
# --------------------------------------------------------------------------
# URL del iframe embed: Google Maps > Compartir > Insertar un mapa > copiar
# el atributo src del <iframe>.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=https://www.google.com/maps?q=Calle%20Zuloaga%2C%20Los%20Chaguaramos%2C%20Caracas%2C%20Venezuela&output=embed

# --------------------------------------------------------------------------
# DATOS DE CONTACTO
# --------------------------------------------------------------------------
NEXT_PUBLIC_COMPANY_NAME=SOLUCIONES PAXO C.A.
# Número de WhatsApp en formato internacional, sin "+" ni espacios.
NEXT_PUBLIC_WHATSAPP_NUMBER=584242250106
NEXT_PUBLIC_PHONE_NUMBER=0424 225 0106
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_ADDRESS=Caracas, Venezuela

# --------------------------------------------------------------------------
# REDES SOCIALES
# --------------------------------------------------------------------------
# URL completa de cada perfil. Deja vacía la que no aplique: el Footer solo
# muestra el ícono de las redes que tengan un valor configurado.
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_TIKTOK_URL=

# --------------------------------------------------------------------------
# EMAIL — buzones por departamento
# --------------------------------------------------------------------------
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SALES_EMAIL=
